# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ELEVENLABS_API_KEY: Optional key for ElevenLabs ultra-realistic neural speech synthesis.
# Users can provide this key to enable custom voice clones and personas.
ELEVENLABS_API_KEY=

# YOUTUBE_API_KEY: Optional YouTube Data API v3 key for searching songs, live streams, and videos directly.
YOUTUBE_API_KEY=

